# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/ott_monitor

# Server port (set automatically by the platform)
PORT=8080

# SRS / upstream endpoint overrides (optional — can be set via UI Settings page)
SRS_WHEP_BASE_URL=http://cdn1.obedtv.live:2023
SRS_API_BASE_URL=http://cdn1.obedtv.live:1985/api/v1
RTMP_INGEST_BASE_URL=rtmp://cdn1.obedtv.live:1935/live
GUACAMOLE_BASE_URL=http://cdn3.obedtv.live:8088/guacamole

# Alert webhooks (optional — can be set via UI Settings page)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
