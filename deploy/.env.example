# Copy to deploy/.env and edit. install.sh creates this automatically with a
# generated password if it does not exist.
#
# IMPORTANT: POSTGRES_PASSWORD and the password inside DATABASE_URL must match.

POSTGRES_USER=ott
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ott_monitor

# The API connects to the database over the host-published port (127.0.0.1:5432).
DATABASE_URL=postgresql://ott:change_me_to_a_strong_password@127.0.0.1:5432/ott_monitor

# --- Authentication ---
# Secret used to sign session cookies. Generate a long random value, e.g.:
#   openssl rand -hex 32
# install.sh sets this automatically on first run.
SESSION_SECRET=change_me_to_a_long_random_secret

# Set to "true" only if you serve the UI over HTTPS (e.g. behind a TLS proxy).
# The default LAN deploy is plain HTTP, so leave it false.
SESSION_COOKIE_SECURE=false

# First-run admin account, created only when the user table is empty.
# Change the password after first login (or set a strong one here before first run).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin

# --- Authentik / OIDC SSO (optional) ---
# Leave blank to disable SSO. Set all three of CLIENT_ID, CLIENT_SECRET, and
# DISCOVERY_URL to enable "Sign in with Authentik". SSO users are auto-created
# as operators.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Authentik OIDC discovery document, e.g.
#   https://authentik.example.com/application/o/<app-slug>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
# Optional fixed callback URL (recommended behind a reverse proxy / DNS name):
#   http://noc.example.com/api/auth/sso/callback
OIDC_REDIRECT_URI=
# Label shown on the SSO button.
OIDC_DISPLAY_NAME=Authentik

# --- Email alerts (SendGrid, optional) ---
# Leave SENDGRID_API_KEY blank to disable email alerts. To enable: create a
# SendGrid API key and verify a sender address, then set both below. Recipient
# addresses are managed in the app under Settings -> alert_email_recipients.
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=
ALERT_FROM_NAME=OTT Stream Monitor
