# Copy to deploy/.env and edit. install.sh creates this automatically with a
# generated password if it does not exist.
#
# IMPORTANT: POSTGRES_PASSWORD and the password inside DATABASE_URL must match.

POSTGRES_USER=ott
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ott_monitor

# The API connects to the database over the host-published port (127.0.0.1:5432).
DATABASE_URL=postgresql://ott:change_me_to_a_strong_password@127.0.0.1:5432/ott_monitor
